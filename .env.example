# Copy to .env.local. Never commit real credentials.
# All secrets must remain server-side; never use NEXT_PUBLIC_ for secrets.

DATABASE_URL=
DIRECT_URL=

# Configure only the AI providers actually enabled by the application.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional external research provider.
TAVILY_API_KEY=

# Private object storage; exact fields depend on the selected provider.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

APP_BASE_URL=http://localhost:3000
