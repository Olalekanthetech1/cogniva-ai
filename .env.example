# Copy to .env.local for local development. Never commit real credentials.
# All secrets must remain server-side; do not prefix secret values with NEXT_PUBLIC_.

# PostgreSQL
DATABASE_URL=
# Optional direct/non-pooled URL for schema migrations when the host provides one.
DATABASE_MIGRATION_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Comma-separated trusted application origins. Defaults to BETTER_AUTH_URL.
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Transactional email via Resend. Registration stays unavailable until both
# values are configured; use a sender/domain verified by your email provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI providers will be added in the tutor implementation phase.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional external research provider.
TAVILY_API_KEY=

# Private object storage; exact fields depend on the selected provider.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

APP_BASE_URL=http://localhost:3000
