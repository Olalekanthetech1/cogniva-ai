{
  "name": "cogniva-ai",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-powered university learning companion built around guided reasoning.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @cogniva/web dev",
    "build": "pnpm --filter @cogniva/web build",
    "start": "pnpm --filter @cogniva/web start",
    "lint": "pnpm --filter @cogniva/web lint",
    "typecheck": "pnpm --filter @cogniva/web typecheck && pnpm --filter @cogniva/database typecheck",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate": "pnpm --filter @cogniva/database generate",
    "db:migrate": "pnpm --filter @cogniva/database migrate",
    "db:studio": "pnpm --filter @cogniva/database studio",
    "test:tutor-intelligence": "node --test apps/web/lib/tutor-intelligence.test.mjs",
    "test:tutor-learning-framework": "node --test apps/web/lib/tutor-learning-framework.test.mjs",
    "test:tutor-markdown": "node --test apps/web/lib/tutor-message-markdown.test.mjs",
    "test:learning-plan-output": "node --test apps/web/lib/learning-plan-output.test.mjs",
    "test:learning-plan-review": "node --test apps/web/lib/learning-plan-review.test.mjs",
    "test:ai-model-registry": "node --test apps/web/lib/ai-model-capabilities.test.mjs apps/web/lib/ai-model-test-policy.test.mjs tests/integration/ai-model-registry.test.mjs",
    "test:auth-lifecycle": "node --test tests/integration/auth-lifecycle.test.mjs",
    "test:academic-reference-foundation": "node --test tests/integration/academic-reference-foundation.test.mjs",
    "test:academic-interoperability": "node --test tests/integration/academic-interoperability.test.mjs",
    "db:audit": "node scripts/audit-neon-schema.mjs",
    "test:db-audit-contract": "node --test scripts/audit-neon-schema-contract.test.mjs",
    "test:ai-adaptive-routing": "node --test apps/web/lib/ai-adaptive-routing.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.19.1"
    }
  }
}
