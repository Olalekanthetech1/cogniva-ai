{
  "name": "cogniva-ai",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-powered university learning companion built around guided reasoning.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @cogniva/web dev",
    "build": "pnpm --filter @cogniva/web build",
    "start": "pnpm --filter @cogniva/web start",
    "lint": "pnpm --filter @cogniva/web lint",
    "typecheck": "pnpm --filter @cogniva/web typecheck && pnpm --filter @cogniva/database typecheck",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate": "pnpm --filter @cogniva/database generate",
    "db:migrate": "pnpm --filter @cogniva/database migrate",
    "db:studio": "pnpm --filter @cogniva/database studio",
    "test:tutor-intelligence": "node --test apps/web/lib/tutor-intelligence.test.mjs",
    "test:tutor-markdown": "node --test apps/web/lib/tutor-message-markdown.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.19.1"
    }
  }
}
